# Шаблон настроек стенда для docker-compose.prod.yml (issue #2). На сервере: cp .env.prod.example .env.prod,
# заполнить и не коммитить (.env.prod в .gitignore). Пароли — длинные случайные: openssl rand -base64 24

# Пока своего домена нет — sslip.io: <что-угодно>.<IP-через-дефисы>.sslip.io резолвится в этот IP
API_DOMAIN=api.81-177-48-254.sslip.io
AUTH_DOMAIN=auth.81-177-48-254.sslip.io

POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Применяются только при первом импорте realm. Потом меняются в админке Keycloak, а не здесь
UNIVER_CLIENT_SECRET=
UNIVER_SUPER_PASSWORD=
UNIVER_STUDENT1_PASSWORD=

# Другой тег образа бэкенда, например для отката
#BACKEND_IMAGE=coungard/univer:backend
